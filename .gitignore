# ignore IDE metadata
.idea/:
.vscode
.vscode/*

# Ignore all env files
.env
*.env
scripts/.env*

# Ignore python artifacts
*.egg-info
*.pyc
__pycache__/

# Exclude all data, logging, and analysis results direcotries
*data/
/phi-data/
/scripts/diagnostics/safe-data/
*log*

# Ignore test/example artifacts
test*.py
test*.ipynb
task_ids.txt
create_tables_mysql.sql
add_existing_patient_example_chunks*.py
*.sh
mysql_data/
db/
db/*